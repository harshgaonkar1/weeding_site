PORT=5000
CORS_ORIGIN=http://localhost:5173

# ==========================================
# DigitalOcean Linux VM PostgreSQL Database
# ==========================================
# Set your DigitalOcean VM IP below (e.g., 159.65.x.x)
POSTGRES_HOST=YOUR_DIGITALOCEAN_VM_IP
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=manish_hadye
POSTGRES_PASSWORD=your_postgres_password

# Complete connection string pointing to your DigitalOcean VM
DATABASE_URL=postgresql://manish_hadye:your_postgres_password@YOUR_DIGITALOCEAN_VM_IP:5432/postgres

# Set to true if DigitalOcean requires SSL connection
PGSSL=false

